# 复制本文件为 config.yaml 后修改（首次运行 ./scripts/install.sh 会自动复制）
# Docker 部署时，带 BRIDGE_ 前缀的环境变量（见 .env）会覆盖下方同名配置项。

server:
  port: 8080
  mode: release
  read_timeout: 15s
  write_timeout: 30s
  upstream_timeout: 25s

huaan:
  # 华安上游域名（务必改为生产/测试真实地址）
  base_url: https://xx.xxx.api.york.xin
  api_path: /upChannelApi
  # 请求华安时是否携带 key 与 sign；true 时按华安规则重签
  sign_enabled: false

database:
  # Docker 部署时由 .env 中 BRIDGE_DATABASE_DSN 覆盖（install.sh 根据 MYSQL_* 自动生成）
  dsn: bridge:请修改数据库密码@tcp(mysql:3306)/insurance_bridge?charset=utf8mb4&parseTime=True&loc=Local

redis:
  addr: redis:6379
  # Docker 部署时由 .env 中 BRIDGE_REDIS_PASSWORD 覆盖（install.sh 根据 REDIS_PASSWORD 自动生成）
  password: 请修改redis密码
  db: 0
  # 银行列表缓存 TTL，0 表示不过期（直至管理后台手动刷新覆盖）
  bank_list_ttl: 0

security:
  # 必须为 32 字节，用于渠道三要素加解密及库内敏感字段
  data_encryption_key: "请替换为32字节密钥0123456789abcdef"
  jwt_secret: "请替换为足够长的随机字符串"

log:
  # 日志级别：测试环境建议 debug，生产环境建议 info（可用 BRIDGE_LOG_LEVEL 覆盖）
  level: info
  file_path: ./logs/app.log
  retention_days: 90
  archive_enabled: true
  max_size_mb: 100

admin:
  default_username: admin
  # 首次启动无管理员时创建；登录后请尽快修改密码
  default_password: 请修改默认管理员密码
  # 开发期 Vue 本地 dev server 跨域，逗号分隔；生产 Nginx 同源部署留空
  cors_origins: ""
