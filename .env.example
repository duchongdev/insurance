# 复制为 .env 后修改（首次运行 ./scripts/install.sh 会自动复制）
# 本文件含敏感信息，请勿提交到 Git。

# ---------- MySQL（Compose 内 MariaDB）----------
# 无法访问 Docker Hub 时可指定内网镜像，如 MYSQL_IMAGE=harbor.example.com/mariadb:10.6
# MYSQL_IMAGE=mariadb:10.6
MYSQL_ROOT_PASSWORD=请修改root密码
MYSQL_DATABASE=insurance_bridge
MYSQL_USER=bridge
MYSQL_PASSWORD=请修改数据库密码

# ---------- Redis（Compose 内 Redis）----------
# 无法访问 Docker Hub 时可指定内网镜像，如 REDIS_IMAGE=harbor.example.com/redis:7-alpine
# REDIS_IMAGE=redis:7-alpine
REDIS_PASSWORD=请修改redis密码

# ---------- 应用（BRIDGE_ 前缀，覆盖 config/config.yaml）----------
# BRIDGE_DATABASE_DSN 由 install.sh / start.sh 根据上方 MYSQL_* 自动生成，请勿手动填写
# BRIDGE_REDIS_PASSWORD 由 install.sh / start.sh 根据上方 REDIS_PASSWORD 自动生成，请勿手动填写

# ---------- 应用镜像（部署脚本本机构建后注入，服务器无需访问 Docker Hub）----------
# BRIDGE_IMAGE=insurance-bridge:deploy

# 日志级别：测试环境 debug，生产环境 info
# BRIDGE_LOG_LEVEL=debug

BRIDGE_HUAAN_BASE_URL=https://xx.xxx.api.york.xin
BRIDGE_HUAAN_API_PATH=/upChannelApi

# 32 字节密钥
BRIDGE_SECURITY_DATA_ENCRYPTION_KEY=请替换为32字节密钥0123456789abcdef
BRIDGE_SECURITY_JWT_SECRET=请替换为足够长的随机字符串

# 可选：首次 seed 的管理员（与 config.yaml 中 admin 段一致）
BRIDGE_ADMIN_DEFAULT_USERNAME=admin
BRIDGE_ADMIN_DEFAULT_PASSWORD=请修改默认管理员密码

# 可选：本地 Vue dev server 跨域（如 http://localhost:5173）；生产 Nginx 同源无需设置
# BRIDGE_ADMIN_CORS_ORIGINS=http://localhost:5173

# ---------- Nginx 反向代理（Compose 内）----------
# 测试环境常用 nginx:1.26.1-alpine 或 harbor.ops.qianxin-inc.cn/butcher/nginx:1.26.3-alpine
# NGINX_IMAGE=nginx:1.26.1-alpine

# ---------- HTTPS（可选，投产推荐）----------
# 将阿里云 SSL 证书（Nginx 格式）放到 deploy/ssl/ 目录：
#   deploy/ssl/fullchain.pem
#   deploy/ssl/privkey.pem
# 放置后 ./scripts/start.sh 自动启用 :443 并将 :80 跳转至 HTTPS
