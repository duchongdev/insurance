# 华安直连集成测试环境变量示例（复制为 .env.huaan 后 source，勿提交 Git）
#
# 详见 docs/TESTING.md
#
#   cp .env.huaan.example .env.huaan
#   set -a && source .env.huaan && set +a
#   make test-huaan

# 必填
export HUAAN_BASE_URL="https://你的华安域名"
export HUAAN_CHANNEL_CODE="你的渠道编码"

# 可选；对应 config huaan.key，写入请求体 key 字段，默认空
# export HUAAN_KEY="你的华安签名密钥"

# 可选，默认 /upChannelApi
# export HUAAN_API_PATH="/upChannelApi"

# 含 PII 接口测试用（明文，直接发给华安）
# export HUAAN_TEST_PHONE="13800138000"
# export HUAAN_TEST_NAME="张三"
# export HUAAN_TEST_ID_CARD="110101199001011234"

# sms/valid 集成测试用验证码（明文）
# export HUAAN_TEST_SMS_CODE="1234"

# productCode、policyId 由集成测试分别从 getProductInfoByChannel、proInsurance 自动获取，无需配置
# 可选：proInsurance 未返回 userId 时，getSignUrl 测试可备用
# export HUAAN_TEST_USER_ID="..."

# getSignUrl 专项（TestHuaAnDirect_GetSignUrl）：先 getBankList 再签约，bankCode 与 payChannelId 须同源
# export HUAAN_TEST_BANK_CODE="BOC"
# export HUAAN_TEST_CARD_TYPE="1"
