# 华安直连集成测试环境变量示例（复制为 .env.huaan 后 source，勿提交 Git）
#
# 详见 docs/TESTING.md
#
#   cp .env.huaan.example .env.huaan
#   set -a && source .env.huaan && set +a
#   make test-huaan

# 必填
export HUAAN_BASE_URL="https://你的华安域名"
export HUAAN_CHANNEL_CODE="你的渠道编码"

# 可选；集成测试默认 sign_enabled=false，请求体不含 key/sign
# export HUAAN_KEY="你的华安签名密钥"

# 可选，默认 /upChannelApi
# export HUAAN_API_PATH="/upChannelApi"

# 含 PII 接口测试用（明文，直接发给华安）
# export HUAAN_TEST_PHONE="13800138000"
# export HUAAN_TEST_NAME="张三"
# export HUAAN_TEST_ID_CARD="110101199001011234"

# 需业务数据的接口（未设置则对应用例 t.Skip）
# export HUAAN_TEST_PRODUCT_CODE="P001"
# export HUAAN_TEST_POLICY_ID="POL001"
